# Database - Supabase PostgreSQL (server-side only)
# Get both values from Supabase Dashboard > Project Settings > API.
# SUPABASE_URL is the "Project URL" (https://<project-ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key. NEVER prefix it
# with VITE_ and never expose it to the browser - it is used only by api/.
# NOTE: before signing up, apply supabase/migrations/0001_initial_schema.sql
# via Supabase Dashboard > SQL Editor (or `supabase db push`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication - REQUIRED
# Random secret for JWT signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# AI Assistant
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email Verification via Brevo (optional, not required for local development)
# Get the API key from Brevo Dashboard > SMTP & API > API Keys.
# BREVO_FROM_EMAIL must be an email address of a validated sender in Brevo
# (Brevo Dashboard > Senders). For local dev, verification links appear in the signup response.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# HMAC secret for email verification tokens (can be any random string)
EMAIL_VERIFICATION_SECRET=financeApp_2026_8xKp92LmQ7

# Optional override for the app's canonical URL.
APP_URL=

# Google OAuth (optional, not required for local development)
# To enable Google Login: create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth-google/callback (dev) and your production domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: explicit OAuth redirect URI. Defaults to http://localhost:3000/api/auth-google/callback in local development.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth-google/callback